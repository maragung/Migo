{
  "$comment": "Opcode registry. Hot opcodes are kept below 0x80 so they encode in a single varint byte. A request/response opcode reuses the same code for the reply, matched by correlation id; errors ride the ERROR flag. Every opcode MUST declare a rate-limit cost (ADR-0006) and a delivery class (ADR-0008).",
  "ranges": [
    { "from": 1,   "to": 15,  "name": "control" },
    { "from": 16,  "to": 31,  "name": "auth_keys" },
    { "from": 32,  "to": 63,  "name": "messaging" },
    { "from": 64,  "to": 79,  "name": "presence" },
    { "from": 80,  "to": 111, "name": "rooms" },
    { "from": 112, "to": 127, "name": "social" },
    { "from": 128, "to": 143, "name": "media" },
    { "from": 144, "to": 159, "name": "notifications" },
    { "from": 160, "to": 175, "name": "economy" },
    { "from": 176, "to": 191, "name": "games_bots" },
    { "from": 192, "to": 207, "name": "moderation" },
    { "from": 208, "to": 223, "name": "federation" },
    { "from": 224, "to": 255, "name": "reserved" }
  ],
  "opcodes": [
    { "name": "HELLO", "code": 1, "direction": "client_to_server", "payload": "Hello", "response": "Welcome",
      "auth": "None", "cost": 5, "class": "Critical", "doc": "Handshake. Also carries optional token and resume." },
    { "name": "PING", "code": 2, "direction": "both", "payload": "Ping", "response": "Pong",
      "auth": "None", "cost": 1, "class": "Critical" },
    { "name": "ACK", "code": 3, "direction": "client_to_server", "payload": "Ack",
      "auth": "None", "cost": 0, "class": "Critical", "doc": "Cumulative watermark; retires held frames." },
    { "name": "ERROR", "code": 4, "direction": "server_to_client", "payload": "Error",
      "auth": "None", "cost": 0, "class": "Critical", "doc": "Standalone (non-correlated) error, usually fatal." },
    { "name": "RECONNECT_HINT", "code": 5, "direction": "server_to_client", "payload": "ReconnectHint",
      "auth": "None", "cost": 0, "class": "Critical" },
    { "name": "AUTHENTICATE", "code": 6, "direction": "client_to_server", "payload": "Authenticate", "response": "Authenticated",
      "auth": "None", "cost": 10, "class": "Critical" },
    { "name": "SUBSCRIBE", "code": 7, "direction": "client_to_server", "payload": "SubscribeRequest", "response": "SubscribeResponse",
      "auth": "User", "cost": 2, "class": "Critical" },
    { "name": "UNSUBSCRIBE", "code": 8, "direction": "client_to_server", "payload": "SubscribeRequest", "response": "SubscribeResponse",
      "auth": "User", "cost": 1, "class": "Critical" },

    { "name": "KEY_PUBLISH", "code": 16, "direction": "client_to_server", "payload": "KeyPublish", "response": "KeyPublishResult",
      "auth": "User", "cost": 20, "class": "Critical", "doc": "Publish public identity/prekeys for this device." },
    { "name": "KEY_BUNDLE_FETCH", "code": 17, "direction": "client_to_server", "payload": "KeyBundleRequest", "response": "KeyBundleResponse",
      "auth": "User", "cost": 5, "class": "Critical" },

    { "name": "MESSAGE_SEND", "code": 32, "direction": "client_to_server", "payload": "MessageSend", "response": "MessageAccepted",
      "auth": "User", "cost": 1, "class": "Critical" },
    { "name": "MESSAGE_EVENT", "code": 33, "direction": "server_to_client", "payload": "MessageEvent",
      "auth": "User", "cost": 0, "class": "Critical", "ack_required": true },
    { "name": "MESSAGE_RECEIPT", "code": 34, "direction": "both", "payload": "MessageReceipt",
      "auth": "User", "cost": 1, "class": "Critical" },
    { "name": "MESSAGE_DELETE", "code": 35, "direction": "client_to_server", "payload": "MessageDelete", "response": "MessageAccepted",
      "auth": "User", "cost": 2, "class": "Critical" },
    { "name": "SYNC", "code": 36, "direction": "client_to_server", "payload": "SyncRequest", "response": "SyncResponse",
      "auth": "User", "cost": 3, "class": "Critical" },
    { "name": "CONVERSATION_LIST", "code": 37, "direction": "client_to_server", "payload": "ConversationListRequest", "response": "ConversationListResponse",
      "auth": "User", "cost": 3, "class": "Critical" },
    { "name": "CONVERSATION_CREATE", "code": 38, "direction": "client_to_server", "payload": "ConversationCreateRequest", "response": "ConversationSummary",
      "auth": "User", "cost": 10, "class": "Critical" },
    { "name": "TYPING", "code": 39, "direction": "both", "payload": "TypingEvent",
      "auth": "User", "cost": 1, "class": "Coalescable", "coalesce_key": "conversation_id" },

    { "name": "PRESENCE_SET", "code": 64, "direction": "client_to_server", "payload": "PresenceUpdate", "response": "Acknowledged",
      "auth": "User", "cost": 1, "class": "Coalescable" },
    { "name": "PRESENCE_EVENT", "code": 65, "direction": "server_to_client", "payload": "PresenceEvent",
      "auth": "User", "cost": 0, "class": "Coalescable", "coalesce_key": "user_id" },

    { "name": "ROOM_JOIN", "code": 80, "direction": "client_to_server", "payload": "RoomJoinRequest", "response": "RoomJoinResponse",
      "auth": "User", "cost": 20, "class": "Critical" },
    { "name": "ROOM_LEAVE", "code": 81, "direction": "client_to_server", "payload": "RoomLeaveRequest", "response": "Acknowledged",
      "auth": "User", "cost": 5, "class": "Critical" },
    { "name": "ROOM_LIST", "code": 82, "direction": "client_to_server", "payload": "RoomListRequest", "response": "RoomListResponse",
      "auth": "User", "cost": 5, "class": "Critical" },
    { "name": "ROOM_MEMBER_EVENT", "code": 83, "direction": "server_to_client", "payload": "RoomMemberEvent",
      "auth": "User", "cost": 0, "class": "Coalescable", "coalesce_key": "room_id" },
    { "name": "ROOM_STATE_EVENT", "code": 84, "direction": "server_to_client", "payload": "RoomStateEvent",
      "auth": "User", "cost": 0, "class": "Coalescable", "coalesce_key": "room_id" },

    { "name": "PROFILE_FETCH", "code": 112, "direction": "client_to_server", "payload": "ProfileRequest", "response": "ProfileResponse",
      "auth": "User", "cost": 3, "class": "Critical" },

    { "name": "NOTIFICATION_EVENT", "code": 144, "direction": "server_to_client", "payload": "NotificationEvent",
      "auth": "User", "cost": 0, "class": "Droppable" },

    { "name": "GAME_ACTION", "code": 176, "direction": "client_to_server", "payload": "GameAction", "response": "Acknowledged",
      "auth": "User", "cost": 2, "class": "Critical" },
    { "name": "GAME_EVENT", "code": 177, "direction": "server_to_client", "payload": "GameEvent",
      "auth": "User", "cost": 0, "class": "Critical" }
  ]
}
