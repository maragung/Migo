  "ascii": "migo-envelope-aad",
  "field_table": [
    {
      "field": "domain",
      "bytes": 17,
      "note": "the fixed purpose label"
    },
    {
      "field": "envelope_version",
      "bytes": 1,
      "note": "must equal the envelope's own version byte"
    },
    {
      "field": "scheme",
      "bytes": 1,
      "note": "must equal the envelope's own scheme byte"
    },
    {
      "field": "sender_device",
      "bytes": 16,
      "note": "the device the frame claims to be from"
    },
    {
      "field": "conversation_id",
      "bytes": 16,
      "note": "the conversation the frame claims to belong to"
    },
    {
      "field": "flags",
      "bytes": 1,
      "note": "bit 0: a message id follows"
    },
    {
      "field": "message_id",
      "bytes": 16,
      "note": "present only when flags bit 0 is set"
    }
  ],
