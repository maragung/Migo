{
  "$schema": "https://migo.dev/design-tokens.schema.json",
  "name": "Migo Design System",
  "version": "3.0.0",
  "description": "The single source of truth for Migo's cross-platform design language, restyled to the docs/design/new-client-ui.tsx reference: a teal-and-orange messenger with a Friends/Rooms/Games/Feed tab strip, closable chat tabs, an orange profile banner, and a cream light surface. Web reads these as CSS custom properties (clients/web/src/app/globals.css), Android maps them into Theme.kt, and the desktop client maps them into theme.rs. One product, one identity, every screen size.",

  "color": {
    "light": {
      "bg": "#fdfbf7",
      "bgElevated": "#ffffff",
      "panel": "#ffffff",
      "panelAlt": "#f5f1e8",
      "panelOverlay": "rgba(255, 255, 255, 0.96)",
      "input": "#ffffff",
      "nav": "#00838f",
      "border": "#e8e2d4",
      "borderStrong": "#d3cab4",
      "borderSoft": "rgba(30, 43, 46, 0.08)",
      "text": "#1e2b2e",
      "textDim": "#5c6a6d",
      "textFaint": "#9aa5a7",
      "accent": "#00838f",
      "accentStrong": "#00606b",
      "accentBright": "#00acc1",
      "accentContrast": "#ffffff",
      "accentGlow": "rgba(0, 131, 143, 0.25)",
      "accentSoft": "rgba(0, 131, 143, 0.06)",
      "accentBorder": "rgba(0, 131, 143, 0.45)",
      "bannerA": "#ea580c",
      "bannerB": "#f97316",
      "bannerC": "#f59e0b",
      "bannerInk": "#ffffff",
      "loginA": "#0093af",
      "loginB": "#00acc1",
      "loginC": "#00838f",
      "positive": "#059669",
      "warning": "#e67700",
      "danger": "#e03131",
      "dangerText": "#c92a2a",
      "offline": "#9aa5a7",
      "gold": "#d97706",
      "bubbleIn": "#ffffff",
      "bubbleOut": "#00838f",
      "inkOnFill": "#ffffff",
      "backdrop": "rgba(15, 30, 32, 0.45)"
    },
    "dark": {
      "bg": "#0c1517",
      "bgElevated": "#122023",
      "panel": "#122023",
      "panelAlt": "#1a2c30",
      "panelOverlay": "rgba(18, 32, 35, 0.94)",
      "input": "#15262a",
      "nav": "#0f3a40",
      "border": "#24393e",
      "borderStrong": "#355158",
      "borderSoft": "rgba(36, 57, 62, 0.6)",
      "text": "#e9f4f5",
      "textDim": "#9db4b8",
      "textFaint": "#64808a",
      "accent": "#00bcd4",
      "accentStrong": "#0093af",
      "accentBright": "#26c6da",
      "accentContrast": "#062a30",
      "accentGlow": "rgba(0, 188, 212, 0.28)",
      "accentSoft": "rgba(0, 188, 212, 0.10)",
      "accentBorder": "rgba(0, 188, 212, 0.55)",
      "bannerA": "#ea580c",
      "bannerB": "#f97316",
      "bannerC": "#f59e0b",
      "bannerInk": "#ffffff",
      "loginA": "#0093af",
      "loginB": "#00acc1",
      "loginC": "#00838f",
      "positive": "#2fce7e",
      "warning": "#f59f00",
      "danger": "#ff5c7a",
      "dangerText": "#ffc2cf",
      "offline": "#64808a",
      "gold": "#fcc419",
      "bubbleIn": "#1a2c30",
      "bubbleOut": "#007e8f",
      "inkOnFill": "#ffffff",
      "backdrop": "rgba(4, 10, 11, 0.72)"
    }
  },

  "typography": {
    "family": "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "baseSize": 14,
    "scale": {
      "micro": {
        "size": 11,
        "weight": 600,
        "lineHeight": 1.3,
        "tracking": "0.4px",
        "case": "uppercase"
      },
      "meta": { "size": 12, "weight": 400, "lineHeight": 1.35 },
      "bodySm": { "size": 13, "weight": 400, "lineHeight": 1.4 },
      "body": { "size": 14, "weight": 400, "lineHeight": 1.45 },
      "titleSm": { "size": 16, "weight": 600, "lineHeight": 1.35 },
      "title": { "size": 18, "weight": 700, "lineHeight": 1.3 },
      "display": { "size": 22, "weight": 700, "lineHeight": 1.25 }
    }
  },

  "shape": {
    "bubble": 16,
    "composerPill": 999,
    "tabChip": 12,
    "listRow": 12,
    "unreadBadge": 999
  },

  "spacing": {
    "base": 4,
    "scale": {
      "0": 0,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "8": 32,
      "10": 40,
      "12": 48
    }
  },

  "radius": {
    "sm": 4,
    "md": 6,
    "lg": 8,
    "pill": 999
  },

  "border": {
    "hairline": "1px solid var(--border)"
  },

  "elevation": {
    "flat": "none",
    "raised": "0 2px 8px rgba(0, 0, 0, 0.10)",
    "overlay": "0 0 14px rgba(0, 0, 0, 0.45)",
    "glowAccentLight": "0 0 12px rgba(0, 131, 143, 0.15)",
    "glowAccentDark": "0 0 12px rgba(0, 188, 212, 0.18)"
  },

  "icon": {
    "sizes": { "sm": 16, "md": 20, "lg": 24 },
    "strokeWidth": 1.75
  },

  "touchTarget": {
    "minimum": 44
  },

  "motion": {
    "durations": { "fast": "120ms", "base": "180ms", "slow": "240ms" },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "reducedMotion": "match prefers-reduced-motion: animations collapse to opacity-only or none"
  },

  "zIndex": {
    "base": 0,
    "dropdown": 100,
    "sticky": 200,
    "overlay": 300,
    "modal": 400,
    "toast": 500
  },

  "breakpoints": {
    "mobileMax": 767,
    "tabletMin": 768,
    "tabletMax": 1023,
    "desktopMin": 1024,
    "wideMin": 1440,
    "contentMax": 1280,
    "panelMax": 640
  }
}
