  "typography": {
    "family": "'Segoe UI', Tahoma, Verdana, Geneva, sans-serif",
    "baseSize": 13,
    "scale": {
      "micro": {
        "size": 10.5,
        "weight": 700,
        "lineHeight": 1.3,
        "tracking": "0.4px",
        "case": "uppercase"
      },
      "meta": {
        "size": 11.5,
        "weight": 400,
        "lineHeight": 1.35
      },
      "bodySm": {
        "size": 12,
        "weight": 400,
        "lineHeight": 1.4
      },
      "body": {
        "size": 13,
        "weight": 400,
        "lineHeight": 1.45
      },
      "titleSm": {
        "size": 14,
        "weight": 700,
        "lineHeight": 1.35
      },
      "title": {
        "size": 16,
        "weight": 700,
        "lineHeight": 1.3
      },
      "display": {
        "size": 20,
        "weight": 700,
        "lineHeight": 1.25
      }
    }
  },
  "shape": {
    "winFrame": 12,
    "authCard": 16,
    "authField": 8,
    "tabChip": 9,
    "composerField": 6,
    "listRow": 0,
    "unreadBadge": 999
  },
  "spacing": {
    "base": 4,
    "scale": {
      "0": 0,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "8": 32,
      "10": 40,
      "12": 48
    }
  },
  "radius": {
    "sm": 4,
    "md": 6,
    "lg": 12,
    "pill": 999
  },
  "border": {
    "hairline": "1px solid var(--border)"
  },
  "elevation": {
    "flat": "none",
    "frameLight": "0 12px 32px rgba(4, 48, 60, 0.16)",
    "frameDark": "0 12px 32px rgba(0, 0, 0, 0.45)",
    "menuLight": "0 10px 24px rgba(4, 48, 60, 0.18)",
    "menuDark": "0 10px 24px rgba(0, 0, 0, 0.45)",
    "focusRing": "0 0 0 3px var(--accent-glow)"
  },
  "icon": {
    "sizes": {
      "sm": 16,
      "md": 20,
      "lg": 24
    },
    "strokeWidth": 1.75
  },
  "touchTarget": {
    "minimum": 44
  },
  "motion": {
    "durations": {
      "fast": "120ms",
      "base": "180ms",
      "slow": "240ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "reducedMotion": "match prefers-reduced-motion: animations collapse to opacity-only or none"
  },
  "zIndex": {
    "base": 0,
    "dropdown": 100,
    "sticky": 200,
    "overlay": 300,
    "modal": 400,
    "toast": 500
  },
  "breakpoints": {
    "mobileMax": 767,
    "tabletMin": 768,
    "tabletMax": 1023,
    "desktopMin": 1024,
    "wideMin": 1440,
    "contentMax": 1280,
    "panelMax": 640
  },
  "metrics": {
    "tabStripHeight": 46,
    "listRowHeight": 58,
    "roomRowHeight": 66,
    "bannerHeight": 71,
    "avatarGutter": 24,
    "transcriptAvatar": 22,
    "listRowAvatar": 38,
    "occupancyBar": 3.5
  }
