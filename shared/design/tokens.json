{
  "$schema": "https://migo.dev/design-tokens.schema.json",
  "name": "Migo Design System",
  "version": "2.0.0",
  "description": "The single source of truth for Migo's cross-platform design language, restyled to the main-ui.jpg reference: a dark-first messenger with a blue-violet accent, round rail controls, and soft 16px bubbles. Web reads these as CSS custom properties (clients/web/src/app/globals.css), Android maps them into Theme.kt, and the desktop client maps them into theme.rs. One product, one identity, every screen size.",

  "color": {
    "light": {
      "bg": "#f1f2f6",
      "bgElevated": "#ffffff",
      "panel": "#ffffff",
      "panelAlt": "#eff1f5",
      "panelOverlay": "rgba(255, 255, 255, 0.96)",
      "input": "#ffffff",
      "nav": "rgba(255, 255, 255, 0.96)",
      "border": "#e3e5ec",
      "borderStrong": "#c9cdd8",
      "borderSoft": "rgba(27, 28, 36, 0.08)",
      "text": "#1b1c24",
      "textDim": "#5c6170",
      "textFaint": "#9ba0ac",
      "accent": "#3b5bdb",
      "accentStrong": "#2f4cb8",
      "accentContrast": "#ffffff",
      "accentGlow": "rgba(59, 91, 219, 0.25)",
      "accentSoft": "rgba(59, 91, 219, 0.06)",
      "accentBorder": "rgba(59, 91, 219, 0.45)",
      "positive": "#0ca678",
      "warning": "#e67700",
      "danger": "#e03131",
      "dangerText": "#c92a2a",
      "offline": "#9ba0ac",
      "gold": "#9a6700",
      "bubbleIn": "#ffffff",
      "bubbleOut": "#3b5bdb",
      "inkOnFill": "#ffffff",
      "backdrop": "rgba(15, 18, 30, 0.45)"
    },
    "dark": {
      "bg": "#141519",
      "bgElevated": "#1b1c24",
      "panel": "#1b1c24",
      "panelAlt": "#24252e",
      "panelOverlay": "rgba(27, 28, 36, 0.94)",
      "input": "#1f2029",
      "nav": "rgba(20, 21, 25, 0.96)",
      "border": "#2a2b36",
      "borderStrong": "#3a3c4a",
      "borderSoft": "rgba(42, 43, 54, 0.6)",
      "text": "#f2f3f7",
      "textDim": "#a0a3b1",
      "textFaint": "#6e7180",
      "accent": "#4c6ef5",
      "accentStrong": "#3b5bdb",
      "accentContrast": "#ffffff",
      "accentGlow": "rgba(76, 110, 245, 0.28)",
      "accentSoft": "rgba(76, 110, 245, 0.10)",
      "accentBorder": "rgba(76, 110, 245, 0.55)",
      "positive": "#2fce7e",
      "warning": "#f59f00",
      "danger": "#ff5c7a",
      "dangerText": "#ffc2cf",
      "offline": "#6e7180",
      "gold": "#fcc419",
      "bubbleIn": "#24252e",
      "bubbleOut": "#4c6ef5",
      "inkOnFill": "#ffffff",
      "backdrop": "rgba(8, 9, 12, 0.72)"
    }
  },

  "typography": {
    "family": "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "baseSize": 14,
    "scale": {
      "micro": {
        "size": 11,
        "weight": 600,
        "lineHeight": 1.3,
        "tracking": "0.4px",
        "case": "uppercase"
      },
      "meta": { "size": 12, "weight": 400, "lineHeight": 1.35 },
      "bodySm": { "size": 13, "weight": 400, "lineHeight": 1.4 },
      "body": { "size": 14, "weight": 400, "lineHeight": 1.45 },
      "titleSm": { "size": 16, "weight": 600, "lineHeight": 1.35 },
      "title": { "size": 18, "weight": 700, "lineHeight": 1.3 },
      "display": { "size": 22, "weight": 700, "lineHeight": 1.25 }
    }
  },

  "shape": {
    "bubble": 16,
    "composerPill": 999,
    "railButton": 999,
    "listRow": 12,
    "unreadBadge": 999
  },

  "spacing": {
    "base": 4,
    "scale": {
      "0": 0,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "8": 32,
      "10": 40,
      "12": 48
    }
  },

  "radius": {
    "sm": 4,
    "md": 6,
    "lg": 8,
    "pill": 999
  },

  "border": {
    "hairline": "1px solid var(--border)"
  },

  "elevation": {
    "flat": "none",
    "raised": "0 2px 8px rgba(0, 0, 0, 0.10)",
    "overlay": "0 0 14px rgba(0, 0, 0, 0.45)",
    "glowAccentLight": "0 0 12px rgba(59, 91, 219, 0.15)",
    "glowAccentDark": "0 0 12px rgba(76, 110, 245, 0.18)"
  },

  "icon": {
    "sizes": { "sm": 16, "md": 20, "lg": 24 },
    "strokeWidth": 1.75
  },

  "touchTarget": {
    "minimum": 44
  },

  "motion": {
    "durations": { "fast": "120ms", "base": "180ms", "slow": "240ms" },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "reducedMotion": "match prefers-reduced-motion: animations collapse to opacity-only or none"
  },

  "zIndex": {
    "base": 0,
    "dropdown": 100,
    "sticky": 200,
    "overlay": 300,
    "modal": 400,
    "toast": 500
  },

  "breakpoints": {
    "mobileMax": 767,
    "tabletMin": 768,
    "tabletMax": 1023,
    "desktopMin": 1024,
    "wideMin": 1440,
    "contentMax": 1280,
    "panelMax": 640
  }
}
