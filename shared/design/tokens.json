{
  "$schema": "https://migo.dev/design-tokens.schema.json",
  "name": "Migo Design System",
  "version": "1.0.0",
  "description": "The single source of truth for Migo's cross-platform design language. Web reads these as CSS custom properties (clients/web/src/app/globals.css), Android maps them into Theme.kt, and the desktop client maps them into theme.rs. One product, one identity, every screen size.",

  "color": {
    "light": {
      "bg": "#f0f2f5",
      "bgElevated": "#ffffff",
      "panel": "#ffffff",
      "panelAlt": "#f5f6f8",
      "panelOverlay": "rgba(255, 255, 255, 0.96)",
      "input": "#ffffff",
      "nav": "rgba(255, 255, 255, 0.95)",
      "border": "#e0e3e8",
      "borderStrong": "#c5cad0",
      "borderSoft": "rgba(26, 29, 36, 0.08)",
      "text": "#1a1d24",
      "textDim": "#5c6370",
      "textFaint": "#9aa1ad",
      "accent": "#0077e6",
      "accentStrong": "#005cb8",
      "accentContrast": "#ffffff",
      "accentGlow": "rgba(0, 119, 230, 0.25)",
      "accentSoft": "rgba(0, 119, 230, 0.06)",
      "accentBorder": "rgba(0, 119, 230, 0.45)",
      "positive": "#00a85a",
      "warning": "#e6a100",
      "danger": "#e04050",
      "dangerText": "#c22837",
      "offline": "#9aa1ad",
      "gold": "#9a6700",
      "bubbleIn": "#ffffff",
      "bubbleOutFrom": "#0077e6",
      "bubbleOutTo": "#0099ff",
      "inkOnFill": "#ffffff",
      "backdrop": "rgba(15, 20, 30, 0.45)"
    },
    "dark": {
      "bg": "#0a0a12",
      "bgElevated": "#14141e",
      "panel": "#111118",
      "panelAlt": "#1a1a28",
      "panelOverlay": "rgba(17, 17, 24, 0.92)",
      "input": "#0d0d16",
      "nav": "rgba(10, 10, 18, 0.95)",
      "border": "#1a1a2e",
      "borderStrong": "#2e2e4a",
      "borderSoft": "rgba(26, 26, 46, 0.6)",
      "text": "#e8e8f0",
      "textDim": "#8888a0",
      "textFaint": "#555570",
      "accent": "#00d4ff",
      "accentStrong": "#0099cc",
      "accentContrast": "#051018",
      "accentGlow": "rgba(0, 212, 255, 0.25)",
      "accentSoft": "rgba(0, 212, 255, 0.05)",
      "accentBorder": "rgba(0, 212, 255, 0.45)",
      "positive": "#00ff88",
      "warning": "#ffaa00",
      "danger": "#ff4466",
      "dangerText": "#ffb3c1",
      "offline": "#555570",
      "gold": "#ffd166",
      "bubbleIn": "#1a1a28",
      "bubbleOutFrom": "#0099cc",
      "bubbleOutTo": "#00d4ff",
      "inkOnFill": "#ffffff",
      "backdrop": "rgba(3, 3, 8, 0.7)"
    }
  },

  "typography": {
    "family": "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "baseSize": 14,
    "scale": {
      "micro": {
        "size": 11,
        "weight": 600,
        "lineHeight": 1.3,
        "tracking": "0.4px",
        "case": "uppercase"
      },
      "meta": { "size": 12, "weight": 400, "lineHeight": 1.35 },
      "bodySm": { "size": 13, "weight": 400, "lineHeight": 1.4 },
      "body": { "size": 14, "weight": 400, "lineHeight": 1.45 },
      "titleSm": { "size": 16, "weight": 600, "lineHeight": 1.35 },
      "title": { "size": 18, "weight": 700, "lineHeight": 1.3 },
      "display": { "size": 22, "weight": 700, "lineHeight": 1.25 }
    }
  },

  "spacing": {
    "base": 4,
    "scale": {
      "0": 0,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "8": 32,
      "10": 40,
      "12": 48
    }
  },

  "radius": {
    "sm": 4,
    "md": 6,
    "lg": 8,
    "pill": 999
  },

  "border": {
    "hairline": "1px solid var(--border)"
  },

  "elevation": {
    "flat": "none",
    "raised": "0 2px 8px rgba(0, 0, 0, 0.08)",
    "overlay": "0 0 14px rgba(0, 0, 0, 0.45)",
    "glowAccentLight": "0 0 12px rgba(0, 119, 230, 0.15)",
    "glowAccentDark": "0 0 12px rgba(0, 212, 255, 0.15)"
  },

  "icon": {
    "sizes": { "sm": 16, "md": 20, "lg": 24 },
    "strokeWidth": 1.75
  },

  "touchTarget": {
    "minimum": 44
  },

  "motion": {
    "durations": { "fast": "120ms", "base": "180ms", "slow": "240ms" },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "reducedMotion": "match prefers-reduced-motion: animations collapse to opacity-only or none"
  },

  "zIndex": {
    "base": 0,
    "dropdown": 100,
    "sticky": 200,
    "overlay": 300,
    "modal": 400,
    "toast": 500
  },

  "breakpoints": {
    "mobileMax": 767,
    "tabletMin": 768,
    "tabletMax": 1023,
    "desktopMin": 1024,
    "wideMin": 1440,
    "contentMax": 1280,
    "panelMax": 640
  }
}
