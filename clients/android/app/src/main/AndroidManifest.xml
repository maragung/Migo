<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The voice call's microphone and its audio routing: RECORD_AUDIO is the microphone itself
         (a runtime permission, asked for at the call button rather than at first launch, because
         the call that needs it is the one that explains why), and MODIFY_AUDIO_SETTINGS is what
         lets the WebRTC audio module put the phone in communication mode and route the call
         audio to the earpiece. Neither is core's business (core is pure signaling), so both
         live here in :app, the module that owns the media plane. XML comments cannot contain a
         double hyphen, so this comment uses parentheses where prose would reach for one. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:name=".MigoApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Migo">

        <!-- allowBackup is off on purpose: the key vault must never be copied off the device
             by the platform backup transport. The private keys live in Keystore-wrapped
             storage and do not leave this install. -->

        <!-- networkSecurityConfig, not usesCleartextTraffic. The config permits cleartext to
             the loopback addresses a developer runs a server on and refuses it everywhere
             else, so a typo in the sign-in field cannot silently downgrade a real
             connection. See res/xml/network_security_config.xml. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Migo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
