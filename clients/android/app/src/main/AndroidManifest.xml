<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The voice call's microphone and its audio routing: RECORD_AUDIO is the microphone itself
         (a runtime permission, asked for at the call button rather than at first launch, because
         the call that needs it is the one that explains why), and MODIFY_AUDIO_SETTINGS is what
         lets the WebRTC audio module put the phone in communication mode and route the call
         audio to the earpiece. Neither is core's business (core is pure signaling), so both
         live here in :app, the module that owns the media plane. XML comments cannot contain a
         double hyphen, so this comment uses parentheses where prose would reach for one. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- The video call's camera, asked for at the video call button the same moment-of-use way as
         the microphone (a runtime permission, one dialog for both when the call asks for video).
         It is optional in the only sense that matters: a video invite answered without it is
         still answered, as an audio call, so refusing the camera never costs the conversation.
         XML comments cannot contain a double hyphen, so this comment uses parentheses where
         prose would reach for one. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:name=".MigoApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Migo">

        <!-- allowBackup is off on purpose: the key vault must never be copied off the device
             by the platform backup transport. The private keys live in Keystore-wrapped
             storage and do not leave this install. -->

        <!-- networkSecurityConfig, not usesCleartextTraffic. The config permits cleartext to
             the loopback addresses a developer runs a server on and refuses it everywhere
             else, so a typo in the sign-in field cannot silently downgrade a real
             connection. See res/xml/network_security_config.xml. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:theme="@style/Theme.Migo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The chat screen chat-list mode stacks for a conversation tapped in the list. It reads
        the same process-held session view model the main activity reads (the application object
        is the one that holds it), so the two activities are two windows onto one session: one
        socket, one set of listeners, one unread count. Not exported because nothing outside the
        app names it; the list starts it with the conversation's id and title as extras. XML
        comments cannot contain a double hyphen, so this comment uses parentheses where prose
        would reach for one. -->
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:theme="@style/Theme.Migo" />

        <!-- The camera shot's door: TakePicture hands the camera app a content uri rather than a
             file path, because the camera is another app and must not see this app's private
             storage. The provider shares only what res/xml/file_paths.xml names (the camera
             subfolder of the cache), read-and-write, and the grant the launch carries is the one
             the camera gets (no other app can reach the uri). XML comments cannot contain a
             double hyphen, so this comment uses parentheses where prose would reach for one. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.filepicker"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
