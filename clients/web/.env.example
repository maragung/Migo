# Migo web client configuration.
#
# These are PUBLIC endpoints only. Every variable here is inlined into the browser bundle at build
# time (that is what the NEXT_PUBLIC_ prefix means), so NOTHING secret may ever be placed in this file
# or in a real .env.local. No tokens, no keys, no credentials. The client holds no server secret; it
# authenticates with the user's own password and thereafter with the user's own session tokens, which
# live only in the browser's IndexedDB, never here.

# REST origin for bootstrap (register, login, refresh, logout).
NEXT_PUBLIC_MIGO_API_URL=http://localhost:8080

# Multi-node deployments: the comma-separated list of server URLs the sign-in screens offer.
# When the list names more than one server, the picker defaults to "Otomatis" — every URL is
# probed (GET /health, in parallel, 3s deadline) and the fastest responder is used, with the
# resolved node shown before it is committed. Unset or single-entry, the picker stays the
# manual host/port form.
# NEXT_PUBLIC_MIGO_SERVERS=http://152.53.102.150:8080,http://node2.example.com:8080

# Gateway WebSocket URL for the realtime session.
NEXT_PUBLIC_MIGO_GATEWAY_URL=ws://localhost:8080/ws

# Reported to the server in the handshake; purely informational.
NEXT_PUBLIC_MIGO_APP_VERSION=0.1.0
