# A build that only works on the maintainer's Node version is a build that fails for
# the next person. engines is a promise, so hold the install to it.
engine-strict=true

# Do not hoist to the workspace root. A package that compiles only because a sibling
# happens to depend on something is a package that breaks the moment it is published.
shamefully-hoist=false

# A lockfile that disagrees with the manifests should fail CI, not resolve to something
# nobody has ever run. (Locally, `pnpm install` still updates it as usual.)
strict-peer-dependencies=false
