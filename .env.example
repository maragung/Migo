# ---------------------------------------------------------------------------
# Migo local development configuration.
#
#   cp .env.example .env
#
# Precedence (lowest -> highest): built-in defaults -> config/*.toml -> env -> CLI flags.
# Nested keys use a double underscore: MIGO_STORE__URL -> store.url
# NEVER commit .env or any real secret (spec 102/103).
# ---------------------------------------------------------------------------

# --- node identity -------------------------------------------------------
MIGO_NODE__ID=dev-local-1
MIGO_NODE__REGION=ap-southeast
MIGO_NODE__COUNTRY=ID
# Roles this node serves. Do NOT list "federation" unless MIGO_FEDERATION__ENABLED=true
# with a peer allow-list: the node refuses to start on a federation role with federation off.
MIGO_NODE__ROLES=api,gateway,room,game
MIGO_NODE__ENVIRONMENT=development
# Node signing key (base64, 32+ bytes). Required only when federation is enabled.
# Generate with: openssl rand -base64 32
# Leave empty in development: an ephemeral key is generated and a warning is logged.
MIGO_NODE__SIGNING_KEY=

# --- listeners -----------------------------------------------------------
MIGO_HTTP__BIND=0.0.0.0:8080
MIGO_HTTP__PUBLIC_URL=http://localhost:8080
MIGO_HTTP__CORS_ORIGINS=http://localhost:3000
MIGO_QUIC__BIND=

# --- storage -------------------------------------------------------------
# backend = memory | postgres. memory keeps nothing across a restart; it is the
# zero-dependency default for a quick local run. Switch to postgres for durable data.
MIGO_STORE__BACKEND=memory
MIGO_STORE__URL=postgres://migo:migo@127.0.0.1:5432/migo
MIGO_STORE__MAX_CONNECTIONS=16

# backend = memory | redis
MIGO_CACHE__BACKEND=memory
MIGO_CACHE__URL=redis://127.0.0.1:6379/0

# --- object storage (S3-compatible) --------------------------------------
MIGO_MEDIA__BACKEND=filesystem
MIGO_MEDIA__ENDPOINT=http://127.0.0.1:9000
MIGO_MEDIA__BUCKET=migo-media
MIGO_MEDIA__ACCESS_KEY=
MIGO_MEDIA__SECRET_KEY=
MIGO_MEDIA__LOCAL_DIR=./var/media

# --- auth ----------------------------------------------------------------
# Symmetric key that signs session tokens (32+ bytes; base64, hex, or raw text).
# Generate a real one with: openssl rand -base64 32
# The value below is the well-known development placeholder: it boots a local node
# and is refused outside development, so it is safe to keep in version control.
# Never reuse it anywhere real.
MIGO_AUTH__TOKEN_KEY=development-only-insecure-token-key
MIGO_AUTH__ACCESS_TTL_SECONDS=900
MIGO_AUTH__REFRESH_TTL_SECONDS=2592000
MIGO_AUTH__ALLOW_REGISTRATION=true

# --- observability -------------------------------------------------------
MIGO_TELEMETRY__LOG_LEVEL=info
MIGO_TELEMETRY__LOG_FORMAT=pretty        # pretty | json
MIGO_TELEMETRY__METRICS_BIND=127.0.0.1:9090
MIGO_TELEMETRY__OTLP_ENDPOINT=
MIGO_TELEMETRY__TRACE_SAMPLE_RATIO=0.01

# --- web client ----------------------------------------------------------
# Read by the web client at BUILD time: Next.js inlines NEXT_PUBLIC_* into the bundle,
# so a change here takes effect on the next `next build`, not on a container restart.
NEXT_PUBLIC_MIGO_API_URL=http://localhost:8080
NEXT_PUBLIC_MIGO_GATEWAY_URL=ws://localhost:8080/ws
NEXT_PUBLIC_MIGO_APP_VERSION=0.1.0
