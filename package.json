{
  "name": "migo-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Migo — TypeScript workspace: protocol bindings, wire codec, client crypto, SDK and web client.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --force",
    "test": "pnpm -r --if-present test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^8.2.2"
  }
}
