{
  "name": "@migo/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Migo client SDK: the policy layer over the wire codec, protocol types and client crypto — REST bootstrap, gateway transport, and end-to-end sessions.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@migo/crypto": "workspace:*",
    "@migo/protocol": "workspace:*",
    "@migo/wire": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
